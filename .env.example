# ========== API ==========
PORT=5000
CORS_ORIGIN=*

# ========== 持久化模式 ==========
# mock     本地预览（默认）：JSON 文件库 apps/api/data/dev.json，零依赖
# postgres VPS 部署：TypeORM + PostgreSQL（schema 由 migrations 管理，启动时自动 migration:run）
APP_MODULE_MODE=mock

# ========== Database (PostgreSQL 15，APP_MODULE_MODE=postgres 时生效) ==========
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=ddp
DB_PASS=ddp_local
DB_NAME=ddpserver
DB_LOG=false

# ========== JWT ==========
JWT_SECRET=dev_jwt_secret_change_in_prod
JWT_EXPIRES_IN=12h

# ========== File Storage ==========
# 上传文件存放根目录（后端绝对路径）；Hostinger VPS 建议 /var/data/ddp/uploads
UPLOAD_ROOT=apps/api/uploads

# ========== AI 非标 Excel 转换（M11，可选） ==========
# 客户上传非标准模板时，AI 自动识别列结构并转换为标准格式。
# 不配置 AI_API_KEY 则该功能关闭，不影响标准模板上传。
# 任意 OpenAI 兼容服务均可（OpenAI / DeepSeek / 通义等）
# 也可在管理端「模型 API」页面运行时维护（数据库配置优先于此处环境变量）。
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=30000

# ========== NCM AI / DI ==========
# OpenAI-compatible API. Use a web-search-capable model for NCM research.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=replace_with_api_key
AI_MODEL=gpt-4o-search-preview
AI_TIMEOUT_MS=60000

{
  "name": "@aeg/web-ops",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/write-version.mjs ops . && vite --port 5174",
    "build": "node ../../scripts/write-version.mjs ops . && tsc -b && vite build",
    "build:android": "tsc -b && vite build --mode android",
    "android:sync": "pnpm run build:android && cap sync android",
    "android:open": "cap open android",
    "preview": "vite preview"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.0",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/share": "8.0.3",
    "axios": "^1.7.7",
    "i18next": "^27.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^18.0.1",
    "react-router-dom": "^6.27.0",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.9"
  }
}
